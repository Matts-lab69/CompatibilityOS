diff --git a/include/wine/cpos_runtime.h b/include/wine/cpos_runtime.h
new file mode 100644
index 0000000..91066ed
--- /dev/null
+++ b/include/wine/cpos_runtime.h
@@ -0,0 +1,27 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef __WINE_CPOS_RUNTIME_H
+#define __WINE_CPOS_RUNTIME_H
+
+#ifdef __linux__
+static inline int cpos_session_enabled(void)
+{
+    const char *value = getenv( "CPOS_SESSION" );
+    return value && !strcmp( value, "1" );
+}
+
+static inline const char *cpos_runtime_dir(void)
+{
+    const char *path = getenv( "XDG_RUNTIME_DIR" );
+    struct stat st;
+    size_t len;
+
+    if (!path || path[0] != '/') return NULL;
+    len = strlen( path );
+    if (len < 2 || path[len - 1] == '/') return NULL;
+    if (lstat( path, &st ) || !S_ISDIR( st.st_mode ) || st.st_uid != getuid() ||
+        (st.st_mode & 0777) != 0700) return NULL;
+    return path;
+}
+#endif
+
+#endif
