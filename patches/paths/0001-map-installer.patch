+static const WCHAR cpos_installerW[] = {'C',':','\\','W','i','n','d','o','w','s','\\',
+                                        'I','n','s','t','a','l','l','e','r'};
+
+static const struct cpos_route
+{
+    const WCHAR *dos;
+    unsigned int len;
+    const char *variable;
+} cpos_routes[] =
+{
+    {cpos_installerW, ARRAY_SIZE(cpos_installerW), "CPOS_WINDOWS_INSTALLER"},
+};
+
+/* The runner supplies normalized absolute directory names without a trailing slash. */
+static const char *cpos_route_root( const struct cpos_route *route )
+{
+    const char *value = getenv( route->variable );
+    size_t len;
+
+    if (!value || value[0] != '/') return NULL;
+    len = strlen( value );
+    if (len < 2 || len >= 4096 || value[len - 1] == '/') return NULL;
+    return value;
+}
